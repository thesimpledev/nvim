# clangd already runs clang-tidy (--clang-tidy in lsp.lua), but its default
# check set is nearly empty. These groups turn it into a live reviewer:
#   bugprone-*     real defects
#   performance-*  accidental copies and other silent slowdowns
#   modernize-*    steers away from the C++98 patterns most tutorials teach
#   readability-*  naming and structure
Checks: >
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -bugprone-easily-swappable-parameters

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
